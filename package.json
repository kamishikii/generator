{
  "name": "drevo-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ДРЕВО — лаборатория процедурных деревьев (WebGL + Capacitor)",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "vite": "^5.4.0"
  }
}
